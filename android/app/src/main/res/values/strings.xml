    <!-- welcome -->
    <string name="welcome_title">Bienvenido a %1$s</string>
    <string name="welcome_body">Activa la identificación de llamadas para saber quién te llama de verdad, aunque el número que se vea sea raro.</string>
    <string name="welcome_start_setup">Empezar configuración</string>
    <string name="welcome_setup_progress">Paso %1$d de %2$d</string>
    <string name="welcome_contacts_title">Acceder a tus contactos</string>
    <string name="welcome_contacts_body">Este permiso permite buscar quién te llama entre tus contactos y mostrar su nombre cuando identifiquemos una llamada por cobrar *99.</string>
    <string name="welcome_phone_state_title">Detectar llamadas entrantes</string>
    <string name="welcome_phone_state_body">Este permiso permite saber cuándo está sonando el teléfono para identificar la llamada.</string>
    <string name="welcome_call_log_title">Leer el número que llama</string>
    <string name="welcome_call_log_body">Android necesita este permiso para compartir con la app el número entrante. Lo usamos para reconocer el formato de llamada por cobrar *99 y buscar el contacto.</string>
    <string name="welcome_notifications_title">Mostrar el aviso de identificación</string>
    <string name="welcome_notifications_body">Este permiso permite mostrar el nombre y el número identificado en una notificación mientras entra la llamada.</string>
    <string name="welcome_overlay_title">Mostrar una tarjeta sobre la llamada</string>
    <string name="welcome_overlay_body">Android te llevará a su permiso especial «Mostrar sobre otras apps». Actívalo para que aparezca una tarjeta con quién llama sobre la pantalla de llamada y luego vuelve aquí.</string>
    <string name="welcome_overlay_granted">Permiso concedido. Continúa para terminar de activar la identificación.</string>
    <string name="welcome_done_title">Todo listo</string>
    <string name="welcome_done_body">Activaremos la identificación de llamadas y el inicio automático después de reiniciar el teléfono. Podrás cambiar el inicio automático desde Ajustes.</string>
    <string name="welcome_grant_permission">Conceder y continuar</string>
    <string name="welcome_grant_overlay">Abrir permiso de Android</string>
    <string name="welcome_continue">Continuar</string>
    <string name="welcome_enable_caller_id">Activar identificación</string>


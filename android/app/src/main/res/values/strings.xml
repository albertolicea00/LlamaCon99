    <string name="settings_dial_mode_prefill">Abre el marcador con el número escrito y tú confirmas la llamada.</string>
    <string name="settings_dial_mode_direct">Inicia la llamada desde Llama con 99 al tocar el contacto. Requiere una sola SIM activa y permisos para llamar y comprobar las SIM.</string>
    <string name="settings_anonymous_swipe_title">Llamada anónima al deslizar</string>
    <string name="settings_anonymous_swipe_subtitle">Desliza un contacto a la izquierda para marcar con #31# (oculta tu número)</string>
    <string name="settings_section_caller_id">Identificación de llamadas</string>
    <string name="settings_caller_id_explanation">Identifica el número real de las llamadas por cobrar y busca el nombre en tus contactos. Para ver la identificación encima de la pantalla de llamada, concede el permiso que aparece abajo. Sin él, esa tarjeta podría no funcionar bien.</string>
    <string name="settings_caller_id_overlay_title">Permiso para mostrar sobre la llamada</string>
    <string name="settings_caller_id_overlay_permission">Aún falta este permiso. Sin él, la identificación sobre la llamada podría no funcionar bien. Toca para concederlo.</string>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lista de contactos -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Monitoreo de llamadas entrantes para el banner de identificación -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Solo se pide en runtime si el usuario activa "Llamar directo" en Ajustes -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:name=".LlamaCon99Application"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LlamaCon99">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LlamaCon99">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".monitor.CallMonitorService"
            android:exported="false"
            android:foregroundServiceType="phoneCall" />

        <receiver
            android:name=".monitor.BootCompletedReceiver"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
